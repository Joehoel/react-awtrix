# Local development (Tier 1). Bun auto-loads this file when you run `bun run dev`.
# Copy to `.env` and fill in. `.env` is gitignored.

# Your AWTRIX 3 device on the LAN.
AWTRIX_HOST=192.168.1.45

# A reachable Home Assistant instance + a long-lived access token
# (HA profile -> Security -> Long-lived access tokens). Only needed locally;
# as an add-on the Supervisor injects SUPERVISOR_TOKEN automatically.
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=your-long-lived-access-token
