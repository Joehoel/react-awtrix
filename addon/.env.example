# Local development. Bun auto-loads this file when you run `bun run dev`.
# Copy to `.env` and fill in. `.env` is gitignored.

# --- MQTT (recommended for local dev) ---
# Connect directly to the same MQTT broker your AWTRIX device uses.
# When both are set, all HA/Supervisor discovery is skipped.
AWTRIX_MQTT_BROKER=mqtt://homeassistant.local:1883
AWTRIX_MQTT_PREFIX=awtrix_demo

# --- Home Assistant (optional) ---
# Only needed if you want live HA entity state (e.g. temperature in WeatherClock).
# Without these, useEntity() returns undefined and components render without HA data.
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=your-long-lived-access-token

# --- HTTP fallback (alternative to MQTT) ---
# Direct HTTP to the AWTRIX device. Only used if MQTT env vars are not set.
# AWTRIX_HOST=192.168.1.45
