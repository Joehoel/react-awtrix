{
  "name": "react-awtrix",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "jsx-runtime": [
        "./dist/jsx-runtime.d.mts"
      ],
      "jsx-dev-runtime": [
        "./dist/jsx-dev-runtime.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jsx-dev-runtime": {
      "import": {
        "types": "./dist/jsx-dev-runtime.d.mts",
        "default": "./dist/jsx-dev-runtime.mjs"
      },
      "require": {
        "types": "./dist/jsx-dev-runtime.d.cts",
        "default": "./dist/jsx-dev-runtime.cjs"
      }
    },
    "./jsx-runtime": {
      "import": {
        "types": "./dist/jsx-runtime.d.mts",
        "default": "./dist/jsx-runtime.mjs"
      },
      "require": {
        "types": "./dist/jsx-runtime.d.cts",
        "default": "./dist/jsx-runtime.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "prepush": "bun run typecheck && bun run lint:fix && bun run format && bun run knip --fix",
    "example:hello": "bun run examples/hello.tsx",
    "example:clock": "bun run examples/clock.tsx",
    "example:progress": "bun run examples/progress.tsx",
    "example:complex": "bun run examples/complex.tsx",
    "example:pomodoro": "bun run examples/pomodoro.tsx",
    "example:mqtt": "bun run examples/mqtt.tsx",
    "example:mqtt:local": "AWTRIX_MQTT_LOCAL_BROKER=1 bun run examples/mqtt.tsx",
    "example:server": "bun --hot examples/server.tsx"
  },
  "dependencies": {
    "aedes": "^1.0.2",
    "arktype": "^2.2.0",
    "mqtt": "^5.15.1",
    "react": "^19.2.7",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-reconciler": "^0.33.0",
    "@typescript/native-preview": "latest",
    "knip": "^6.27.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.13"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "typescript": ">=5 <8"
  }
}
